<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     AndroidManifest.xml — AuraOrbit Live Wallpaper
     
     Declares:
       1. MyWallpaperService   — The live wallpaper service that hosts libGDX.
       2. LiveWallpaperSettings — Preference Activity for app selection & grouping.
     
     Permissions:
       - QUERY_ALL_PACKAGES: Required to enumerate installed apps for selection.
       - READ_EXTERNAL_STORAGE: Fallback for system wallpaper retrieval on older APIs.
     ═══════════════════════════════════════════════════════════════════════════ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ─── Permissions ──────────────────────────────────────────────────── -->
    <!-- 
         QUERY_ALL_PACKAGES is required to use PackageManager.getInstalledApplications()
         on Android 11+ where package visibility filtering is enforced.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- ─── Feature Declarations ─────────────────────────────────────────── -->
    <!--
         Declare OpenGL ES 2.0 as required. libGDX requires at minimum GL ES 2.0,
         and we use it for all 3D rendering (DecalBatch, MeshBuilder, etc.).
    -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- 
         Declare the live wallpaper feature so the Play Store filters correctly.
    -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraOrbit">

        <!-- ═══════════════════════════════════════════════════════════════
             1. LIVE WALLPAPER SERVICE
             
             This is the entry point that Android's Wallpaper Picker invokes.
             - BIND_WALLPAPER permission prevents other apps from binding to it.
             - The intent-filter advertises this as a WallpaperService.
             - The meta-data points to res/xml/wallpaper.xml which declares
               the settings Activity and thumbnail.
             ═══════════════════════════════════════════════════════════════ -->
        <service
            android:name=".MyWallpaperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">

            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- ═══════════════════════════════════════════════════════════════
             2. SETTINGS ACTIVITY
             
             Launched from the wallpaper picker's "Settings" button.
             The user configures:
               - Which apps to display on the sphere
               - App grouping (folders with colors)
               - Whether to retain the system wallpaper as background
               - Active home screen page for rendering
             
             exported=true so the wallpaper picker can launch it via Intent.
             ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".LiveWallpaperSettings"
            android:label="@string/settings_title"
            android:theme="@style/Theme.AuraOrbit.Settings"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
