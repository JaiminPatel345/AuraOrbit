<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar menu for AppPickerFragment — registered via MenuProvider so it is
     only inflated while the fragment is in the RESUMED state. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Select all apps currently visible in the (possibly filtered) list. -->
    <item
        android:id="@+id/action_select_all"
        android:title="@string/picker_select_all"
        app:showAsAction="never" />

    <!-- Clear the entire selection (not limited to the filtered view). -->
    <item
        android:id="@+id/action_clear_all"
        android:title="@string/picker_clear_all"
        app:showAsAction="never" />

</menu>
