<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000">

    <!-- Center Container for Sphere and Overlay Zone -->
    <FrameLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Sphere Mock -->
        <View
            android:id="@+id/sphere_mock"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/real_sphere"
            android:layout_gravity="top|start" />

        <!-- Gesture Capture Zone Mock (Placed on top of the sphere so the blue lines are visible) -->
        <View
            android:id="@+id/gesture_zone_mock"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/gesture_capture_mock"
            android:layout_gravity="top|start" />
    </FrameLayout>

    <!-- Top Bar (Buttons) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#AA000000">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="Cancel"
            android:layout_gravity="start|center_vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_gravity="end|center_vertical" />
    </FrameLayout>

    <!-- Bottom Bar (Text and Slider) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:padding="24dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adjust Gesture Capture Area"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The blue dashed zone shows where gestures spin the sphere. Touches outside it control the launcher."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"/>
            
        <TextView
            android:id="@+id/tv_percent_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#00E6FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"/>
            
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_capture_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="50"
            android:valueTo="150"
            android:value="100"
            android:stepSize="1"
            app:thumbColor="#00E6FF"
            app:trackColorActive="#00E6FF"
            app:trackColorInactive="#8800E6FF"/>
    </LinearLayout>

</FrameLayout>
