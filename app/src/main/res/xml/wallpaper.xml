<?xml version="1.0" encoding="utf-8"?>
<!-- 
     wallpaper.xml — Wallpaper service metadata
     
     android:settingsActivity points to our preference screen so the
     wallpaper picker shows a "Settings" button when this wallpaper is selected.
     
     android:thumbnail provides the preview icon in the wallpaper picker grid.
-->
<wallpaper xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.jaimin.auraorbit.LiveWallpaperSettings"
    android:thumbnail="@mipmap/ic_launcher"
    android:description="@string/wallpaper_description" />
