<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.AuraOrbit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/settings_primary</item>
        <item name="colorOnPrimary">@color/settings_on_primary</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
    </style>

    <!-- Settings Activity theme — dark with material surfaces -->
    <style name="Theme.AuraOrbit.Settings" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/settings_primary</item>
        <item name="colorOnPrimary">@color/settings_on_primary</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>
</resources>
