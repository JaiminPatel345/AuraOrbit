<?xml version="1.0" encoding="utf-8"?>
<!--
  sphere_launch_enter.xml — Enter animation for apps launched from AuraOrbit sphere.
  Mimics One UI's task-open feel: scale from 92% + fade in over 250ms with
  decelerate interpolator (fast-in, slow-out).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">

    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="250" />

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="250" />

</set>
